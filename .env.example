NODE_ENV=development
HOST=0.0.0.0
PORT=3333
API_PREFIX=/api
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000

# Production cookie auth requires:
# - NODE_ENV=production
# - CORS_ORIGINS with explicit frontend origins, never "*"
# - CORS_ALLOW_CREDENTIALS=true
# - JWT_AUTH_MODE=shared-secret or jwks
# - JWT_SHARED_SECRET set outside git when shared-secret is used, or JWT_JWKS_URL when jwks is used
# - AUTH_COOKIE_SAME_SITE=none only when frontend/API are cross-site HTTPS origins
CORS_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
REPOSITORY_DRIVER=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_STORAGE_ALLOWED_BUCKETS=uploads,assets,course-materials,checklist-photos,company-assets
SUPABASE_STORAGE_MAX_UPLOAD_BYTES=104857600
JWT_AUTH_MODE=disabled
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALLOWED_ALGORITHMS=HS256
JWT_SHARED_SECRET=
JWT_JWKS_URL=
JWT_ROLE_CLAIM=role
JWT_COMPANY_ID_CLAIM=company_id
JWT_EMAIL_CLAIM=email
JWT_CLOCK_TOLERANCE_SECONDS=5
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SAME_SITE=lax
PUBLIC_TENANT_CACHE_TTL_SECONDS=60

# Invite delivery. Production must use smtp and an HTTPS activation base URL.
INVITE_DELIVERY_PROVIDER=noop
INVITE_ACTIVATION_BASE_URL=http://localhost:8080/ativar-convite
INVITE_DELIVERY_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
