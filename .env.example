NODE_ENV=development
HOST=0.0.0.0
PORT=3333
API_PREFIX=/api
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
REPOSITORY_DRIVER=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_STORAGE_ALLOWED_BUCKETS=uploads,assets,course-materials,checklist-photos,company-assets
SUPABASE_STORAGE_MAX_UPLOAD_BYTES=104857600
JWT_AUTH_MODE=disabled
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALLOWED_ALGORITHMS=HS256
JWT_SHARED_SECRET=
JWT_JWKS_URL=
JWT_ROLE_CLAIM=role
JWT_COMPANY_ID_CLAIM=company_id
JWT_EMAIL_CLAIM=email
JWT_CLOCK_TOLERANCE_SECONDS=5
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PUBLIC_TENANT_CACHE_TTL_SECONDS=60
